{
	"name": "ewr-compliance",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.33.2",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite dev --port 7790",
		"build": "vite build",
		"preview": "vite preview --port 7790",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test --config e2e/playwright.config.ts",
		"test:private": "pnpm data:private && EWR_TIER=private vitest run && EWR_TIER=private playwright test --config e2e/playwright.config.ts",
		"data:sample": "node tools/sample-data.mjs",
		"data:private": "bash -e tools/sync-private.sh"
	},
	"devDependencies": {
		"@playwright/test": "1.64.1",
		"@sveltejs/adapter-static": "4.0.1",
		"@sveltejs/kit": "3.1.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/geojson": "7946.0.16",
		"@types/node": "24.12.2",
		"svelte": "5.57.3",
		"svelte-check": "4.7.7",
		"typescript": "6.0.3",
		"vite": "8.3.5",
		"vitest": "5.0.3"
	},
	"dependencies": {
		"maplibre-gl": "6.16.0",
		"pmtiles": "4.5.0",
		"uplot": "1.6.32",
		"xlsx": "file:vendor/xlsx-0.20.3.tgz"
	},
	"imports": {
		"#lib/*": "./src/lib/*",
		"#e2e/*": "./e2e/*"
	}
}
